  "distanthorizons.config.server.syncOnLoadRateLimit": "加载同步速率限制",
  "distanthorizons.config.server.syncOnLoadRateLimit.@tooltip": "客户端每秒发送多少个 LOD 同步请求？\n也限制允许保留在服务器队列中的客户端请求数量。",
  "distanthorizons.config.server.maxSyncOnLoadRequestDistance": "加载同步最大请求距离",
  "distanthorizons.config.server.maxSyncOnLoadRequestDistance.@tooltip": "设置允许同步的玩家周边距离。\n通常应不小于 maxGenerationRequestDistance。",
  "distanthorizons.config.server.playerBandwidthLimit": "每位玩家带宽上限（KB/s）",
  "distanthorizons.config.server.playerBandwidthLimit.@tooltip": "向每位客户端上传 LOD 的最大速度，以 KB/s 计。\n设为 0 则不限制。",
  "distanthorizons.config.server.globalBandwidthLimit": "总带宽上限（KB/s）",
  "distanthorizons.config.server.globalBandwidthLimit.@tooltip": "向所有客户端上传 LOD 的最大总速度，以 KB/s 计。\n设为 0 则不限制。",
