  "distanthorizons.config.server.generationRequestRateLimit": "生成请求速率限制",
  "distanthorizons.config.server.generationRequestRateLimit.@tooltip": "客户端每秒发送多少个 LOD 生成请求？\n也限制允许保留在服务器队列中的客户端请求数量。",
  "distanthorizons.config.server.maxGenerationRequestDistance": "生成请求最大距离",
  "distanthorizons.config.server.maxGenerationRequestDistance.@tooltip": "设置允许在玩家周围生成的最大距离。",
  "distanthorizons.config.server.enableRealTimeUpdates": "启用实时更新",
