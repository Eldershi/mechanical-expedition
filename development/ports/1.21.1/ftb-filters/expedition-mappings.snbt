  "objects": {
    "327F0404329C1FEE": {
      "description": [
        "{image:expedition_research:textures/quests/91b453914a5c9c0db5a0efcb.png width:32 height:32 align:center}",
        "{image:expedition_research:textures/quests/dc372d3ab195db8cc64309ef.png width:240 height:120 align:center}",
        "配方输入：盖亚之魂×1，重复4槽。泰拉钢锭×1。",
        "用盖亚之魂与泰拉钢制作盖亚魂锭，再对同一合格场地信标潜行右击，挑战强化盖亚。遗物随机性不能锁定本章毕业。新生魔艺和铁魔法均可独立于盖亚Ⅱ挑战推进。",
        "取得盖亚魂锭。",
        "可选工程：自动补水。"
      ]
    },
    "0FBC53BEE0AB7A92": {
      "icon": "cmi:smart_mechanism",
      "description": [
        "分开建设炼钢、原油分馏、塑料和硅材料供应。智能构件接续处理器与工程零件。",
        "首批 AE2 处理器可走机械动力序列装配。得到智能构件后再扩建压印与装配生产，为不同油品和化工中间产物分别准备缓存。"
      ],
      "omit_tasks": [
        "4F45594E2146AE63"
      ]
    },
    "230DBA1D29242001": {
      "description": [
        "制作末影构件，可用于集成工作站制造无线接收器、空间 IO 端口、空间塔和无限范围增幅器。"
      ]
    },
    "5A0D22405AE2F4AE": {
      "title": "末影构件与空间网络"
    },
    "67C71691EE0FB154": {
      "title": "末影构件与空间网络",
      "icon": "cmi:ender_mechanism"
    },
    "3B09C0DEB5D3ECB2": {
      "title": "气密供汽管线",
      "description": [
        "用机巧新生的气密管把锅炉蒸汽出口直接接到沉浸工程精炼机的一侧进料口，搭建裂化用的蒸汽管线。"
      ]
    },
    "3D5497B8DC0ED5B6": {
      "title": "锅炉蒸汽出口",
      "description": [
        "把机巧新生的锅炉蒸汽出口装到有水并受热的机械动力锅炉上，再接气密管导出蒸汽。"
      ]
    },
    "23EED5BF56818EA1": {
      "title": "铸铁锅炉",
      "subtitle": "制作高阶蒸汽设备",
      "description": [
        "制作 Steam Powered 的铸铁锅炉，搭配铸铁燃烧器和设备建立高阶蒸汽动力。"
      ]
    },
    "0E0683A73BB85ABC": {
      "title": "气密储罐",
      "subtitle": "储存气态蒸汽",
      "description": [
        "将气密储罐接入机巧新生气密管，缓存供汽。"
      ]
    },
    "3426EEB10B251CA4": {
      "title": "气密储罐",
      "subtitle": "储存气态蒸汽",
      "description": [
        "将气密储罐接入机巧新生气密管，缓存供汽。"
      ]
    },
    "371E3D200A96A15A": {
      "title": "轴驱动气密泵",
      "subtitle": "用旋转动力推动气体",
      "description": [
        "将轴驱动气密泵接入机巧新生气密管，给泵转轴供动力。气管可输送包括蒸汽在内的气体。"
      ]
    },
    "49FAC7F5B7F68763": {
      "description": [
        "准备青铜构件。把青铜板弯成坯料、注入熔融青铜并装上青铜齿轮、青铜板和机械零件。",
        "先让一套 Steam Powered 锅炉、引擎与飞轮持续驱动加工工位，再扩展供水和燃料缓存。"
      ]
    },
    "38472ADBCFC92083": {
      "description": [
        "用 Steam Powered 的蒸汽引擎和配套飞轮输出旋转动力。把锅炉产出的蒸汽经流体管道送进引擎。"
      ]
    },
    "5227B74E4F8FF3F5": {
      "description": [
        "用 Steam Powered 的蒸汽引擎和配套飞轮输出旋转动力。把锅炉产出的蒸汽经流体管道送进引擎。"
      ]
    },
    "243EF0B9E933D85A": {
      "description": [
        "将 Steam Powered 的锅炉放在燃烧器上方。给锅炉供水和燃烧器供燃料，用机械动力的流体管道导出蒸汽。"
      ]
    },
    "12CEF39F02D4EB3A": {
      "description": [
        "将 Steam Powered 的锅炉放在燃烧器上方。给锅炉供水和燃烧器供燃料，用机械动力的流体管道导出蒸汽。"
      ]
    },
    "5BB078BA5116FE68": {
      "description": [
        "把青铜板用构件模具弯成坯料，依次注入熔融青铜、装上青铜齿轮、青铜板和机械零件。"
      ]
    },
