	quests: [
		{
			id: "4B531EB57A1DDA7E"
			title: "种子压油：选定Create路线"
			icon: "createdieselgenerators:plant_oil_bucket"
			x: -6.0d
			y: -2.3d
			optional: false
			tasks: [
				{
					id: "307361C38B269A94"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/8097ca0339aa9ea19c95b974.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/97b253f0d28d190fb3ea5875.png width:240 height:196 align:center}"
				"准备种子tag中任一种及Create压块加工能力。保留普通种植来源。"
				"按1份种子→100mB植物油压块配方加工，管线单独导出。"
				"取得100mB植物油。"
				"与乙醇进入搅拌制生物柴油。"
			]
		}
		{
			id: "005B8FA1F319CACC"
			title: "搅拌制生物柴油并保留备选"
			icon: "createdieselgenerators:biodiesel_bucket"
			x: 3.0d
			y: 0.7d
			optional: false
			tasks: [
				{
					id: "63DD4A4F6D9102C7"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/807ea2315ad71e521494e84e.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/f412378315d518a00710b8e5.png width:240 height:196 align:center}"
				"选定Create搅拌：100mB植物油＋100mB乙醇。"
				"接两股流体并按搅拌配方运行，收集200mB生物柴油。IErefinery/biodiesel已被移除。"
				"正确流体进入独立罐。机器与管路可使用。原料实际消耗。"
				"供柴油发电机，或选其他已注册燃料。糖＋杂酚油发酵为另一路线。"
			]
		}
		{
			id: "0AA308545F06C1C8"
			title: "柴油发电机带负载运行"
			icon: "immersiveengineering:diesel_generator"
			x: 6.0d
			y: 0.1d
			optional: false
			tasks: [
				{
					id: "0366F884E6598178"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/12b3f633482754edd1ce1454.png width:32 height:32 align:center}"
				"完整结构、允许燃料、流体输入和至少一个有需求能量出口。"
				"锤敲中央发电机/散热模块形成。底部输入燃料，上方最多三个输出分担总功率，检查默认红石停机。"
				"燃料减少且负载储能增加。无需求不工作。"
			]
		}
		{
			id: "5986E2E649E383CB"
			title: "玻璃罩跑通种植循环"
			icon: "immersiveengineering:cloche"
			x: -6.0d
			y: 3.7d
			optional: false
			tasks: [
				{
					id: "084F31A730AC0EB2"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/4abceca430cbd036c58e5f78.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/114166ddcf754fcf21da8e3f.png width:240 height:111 align:center}"
				"有水、FE、所选种子与正确土壤。肥料加速可选。"
				"按作物配方放土壤/种子，给水和能量，前方出口接箱。首次用小规模检查。"
				"连续收两批作物，种子/土壤仍在。"
				"可供乙醇或植物油原料。普通农场和其他种植法同样保留。"
			]
		}
		{
			id: "318A623AA4201313"
			title: "工业发酵机加工可发酵原料"
			icon: "immersiveengineering:fermenter"
			x: -3.0d
			y: 3.2d
			optional: false
			tasks: [
				{
					id: "3DDA190A6B161A80"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/936d810b8604cd359b2c4c51.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/1088d35d56d2439962702fd6.png width:240 height:120 align:center}"
				"有轻型工程构件、多方块材料、FE及可发酵原料原料。"
				"锤敲有工程块侧的中央炼药锅。背蓝口入物、橙口出副产、下方出流体。红石默认暂停。"
				"一份可发酵原料得到100mB乙醇。生物质是概率副产，不能把配方查询展示1当100%概率。"
				"另可用CDG糖浆发酵。按所需产物选择发酵设备。"
			]
		}
		{
			id: "42F4F4E01A30FD2E"
			title: "储存乙醇并核流体类型"
			icon: "immersiveengineering:ethanol_bucket"
			x: 0.0d
			y: 2.7d
			optional: false
			tasks: [
				{
					id: "1E01DD9A3164782E"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/fefe7a7dc517d1e89712c445.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/1088d35d56d2439962702fd6.png width:240 height:120 align:center}"
				"工业发酵或CDG糖浆配方任选。容器与液体分清。"
				"用独立管线把乙醇导入罐，记下输入输出mB。"
				"让乙醇稳定流入储罐，检查原料供应与输出管路。"
				"可制生物柴油、乙醛。不同乙醇tag备选不要求同时提供。"
			]
		}
		{
			id: "425F3F780114BFE2"
