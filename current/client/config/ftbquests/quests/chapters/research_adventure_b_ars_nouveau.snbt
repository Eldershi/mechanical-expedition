				"{image:expedition_research:textures/quests/937cbc8f14bdf2b7426404d8.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/dcbbffb0247e9f3f81c5ea46.png width:240 height:120 align:center}"
				"配方输入：法师的法术书×1。下界之星×1。荒野供物×1。绿宝石×1，重复2槽。末影珍珠×1，重复3槽。不死图腾×1。"
				"升级配方使用法师书、下界之星、荒野贡物、两颗绿宝石、三颗末影珍珠和不死图腾。材料会消耗，原书知识迁移由模组处理。它解锁三阶魔符的使用。不是所有魔符都要先打Boss。"
				"取得大法师法术书。"
				"星宝石兽：物流过滤。"
			]
		}
		{
			id: "154218EC9951B38D"
			title: "星宝石兽：物流过滤"
			icon: "ars_nouveau:starbuncle_charm"
			x: 2.027d
			y: 4.043d
			optional: true
			tasks: [
				{
					id: "4F9C15E09E2EDEE7"
					type: "item"
					item: "ars_nouveau:starbuncle_charm"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/c3ed5e6d2228608f98e3487c.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/e96f4621852fe7c29663ddda.png width:240 height:228 align:center}"
				"配方输入：星宝石兽碎片×1。金锭×1，重复4槽。工作能力：附魔装置。"
				"在林地用金粒换碎片，再按附魔装置配方做护符。地面使用护符召出，支配之杖先点兽再点箱为输出，反向为取料。物品展示框/物品卷轴过滤，先用一组物品检查，不混收灌注室助剂。"
				"取得星宝石兽护符。"
				"德格米：生物资源工坊。"
			]
		}
		{
			id: "5EF745C638EFABDA"
			title: "德格米：生物资源工坊"
			icon: "ars_nouveau:drygmy_charm"
			x: 3.175d
			y: -0.234d
			optional: true
			tasks: [
				{
					id: "67313899A5DCA943"
					type: "item"
					item: "ars_nouveau:drygmy_charm"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/8cf4f1e49f489345cca19003.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/566bf3b2c178d36b68b67139.png width:240 height:228 align:center}"
				"配方输入：德格米碎片×1。生鳕鱼×1 或 熟鳕鱼×1（共17个任选一种备选）。小麦×1。苹果×1。胡萝卜×1。工业大麻种子×1 或 甜菜种子×1（共20个任选一种备选）。魔源宝石×1，重复3槽。工作能力：附魔装置。"
				"向野生德格米投荒野之角取得碎片，再制作护符，对苔石使用形成石阵。旁放箱子与魔源罐，10格内增加生物种类提高幸福度。产出受掉落规则约束，不能凭收容Boss假定无限下界之星或龙蛋。"
				"取得德格米护符。"
				"薇克精：给目标，再给原料。"
			]
		}
		{
			id: "37C92F2E134B049F"
			title: "薇克精：给目标，再给原料"
			icon: "ars_nouveau:wixie_charm"
			x: 7.222d
			y: 1.71d
			optional: true
			tasks: [
				{
					id: "64F6C1AEC63C40D5"
					type: "item"
					item: "ars_nouveau:wixie_charm"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/bacf148ca47a6ec5e93b8c15.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/81ac4d625704df738a880cbb.png width:240 height:228 align:center}"
				"配方输入：薇克精碎片×1。橡树树苗×1 或 云杉树苗×1（共149个任选一种备选）。绿宝石×1。橡木工作台×1。酿造台×1。工作能力：附魔装置。"
				"女巫半血及以下时施放解除魔法得碎片，做护符后对炼药锅使用。用目标成品右击锅，附近给材料与魔源。输出收集可交星宝石兽。红石信号会停止合成。手册中英页有错位，优先英文与实际界面。"
				"取得薇克精护符。"
				"风转草：多样环境才生产。"
			]
		}
		{
			id: "4DACFC1AC65961BD"
			title: "风转草：多样环境才生产"
			icon: "ars_nouveau:whirlisprig_charm"
			x: 5.062d
			y: 4.32d
			optional: true
			tasks: [
				{
					id: "7E760C04EF376854"
					type: "item"
					item: "ars_nouveau:whirlisprig_charm"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/3b0b15be67e8ec031761dc2c.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/8aee6a0366283e2998711479.png width:240 height:228 align:center}"
				"配方输入：风转草碎片×1。魔源宝石×1。法师之花种子×1。法师之花×1。钻石×1。橡树树苗×1。云杉树苗×1。白桦树苗×1。小麦种子×1。工作能力：附魔装置。"
				"在森林的野生风转草附近长出树，取得碎片并制护符，对花使用。旁边放箱子及魔源，在10格内布置多种自然方块，空手查询幸福度并等待更新。不是放一棵树就保证持续产量。"
				"取得风转草护符。"
				"法术工具、药水与使魔选修。"
			]
		}
		{
			id: "59C81C0F733EBD4A"
			title: "法术工具、药水与使魔选修"
			icon: "ars_nouveau:enchanters_mirror"
			x: 10.057d
			y: 4.317d
			optional: true
			tasks: [
				{
					id: "5136FD084675CB52"
					type: "item"
					item: "ars_nouveau:enchanters_mirror"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/7eca84e70073297f923bff3b.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/af8e6405681ec1b4dc29fbd4.png width:240 height:228 align:center}"
				"配方输入：魔源宝石块×1。玻璃×1 或 通透玻璃×1（共67个任选一种备选），重复2槽。操纵之精华×1，重复2槽。烈焰至高木原木×1 或 奔流至高木原木×1（共20个任选一种备选），重复2槽。金锭×1，重复2槽。工作能力：附魔装置。"
				"羊皮纸先放抄写台，再潜行以选定法术的书写入。各工具自带形态，按手册选杖/剑/镜等。药水混合比例、远程水晶、使魔绑定与炮塔均为独立工具路线。"
				"取得巫师之镜。"
				"按所选分支继续，或返回魔法总览选择另一体系。"
			]
		}
	]
