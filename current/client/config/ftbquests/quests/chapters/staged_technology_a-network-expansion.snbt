	quests: [
		{
			id: "153C1C0E00B07B8F"
			title: "扩展到控制器网络"
			icon: "ae2:controller"
			x: -9.3d
			y: 1.1d
			optional: false
			tasks: [
				{
					id: "593C82F44AE6040C"
					type: "item"
					item: "ae2:controller"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/716224e099f6fd2f06e6bcb2.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/09a3903fc4dc8ab2e038cefc.png width:240 height:120 align:center}"
				"选定工艺：合成。所有输入槽同时满足，每个槽的备选任选一种。"
				"材料槽0： 智能构件 ×1。"
				"材料槽1： 陨石粉 ×1。"
				"材料槽2： 智能构件 ×1。"
				"材料槽3： 陨石粉 ×1。"
				"材料槽4： 智能机壳 ×1。"
				"材料槽5： 陨石粉 ×1。"
				"材料槽6： 智能构件 ×1。"
				"材料槽7： 陨石粉 ×1。"
				"材料槽8： 智能构件 ×1。"
				"小网可不放控制器。超过8个通道设备后再扩展。粗线主干旁分8设备支线，设备不能串在32通道主路中间当粗线。"
				"ME控制器 ×1。"
				"返回章节选择其他并行目标。"
			]
		}
		{
			id: "2C89B9E03CB0FCDB"
			title: "搭一对ME P2P"
			icon: "ae2:me_p2p_tunnel"
			x: -3.65d
			y: -2.75d
			optional: true
			tasks: [
				{
					id: "77642C73C30C7696"
					type: "item"
					item: "ae2:me_p2p_tunnel"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/cd5016be2250640a5215647f.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/05828f56e1a4fada19277895.png width:240 height:95 align:center}"
				"选定工艺：部件装配机。所有输入槽同时满足，每个槽的备选任选一种。"
				"材料槽0： 智能构件 ×1。"
				"材料槽1： 银板 ×1。"
				"材料槽3： 福鲁伊克斯水晶 ×1。"
				"内存卡Shift右键输入端，再右键输出端。承载P2P的子网也要供电并占通道。输入32通道在多个输出间分配，不会复制。"
				"ME P2P通道 ×2。"
				"返回章节选择其他并行目标。"
			]
		}
		{
			id: "50A822EA089E2261"
			title: "隔离一个功能子网"
			icon: "minecraft:book"
			x: -1.5d
			y: -1.9d
			optional: true
			tasks: [
				{
					id: "2828877FF3B38339"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: ["相应设备已成型、辅助供给及输出余量均就绪。" "用石英纤维只共享电力。主网存储总线贴子网接口只暴露存储。合成样板不会因此自动跨网可见。" "逐条观察动作所述状态，保存投料、结果与失败条件。背包拥有设备不算完成。" "返回章节选择其他并行目标。"]
		}
		{
			id: "5AFC0A738B6A68C9"
			title: "迁移存储盘"
			icon: "ae2:io_port"
			x: -1.5d
