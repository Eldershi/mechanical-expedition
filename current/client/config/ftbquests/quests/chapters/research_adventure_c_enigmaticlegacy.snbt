			description: [
				"{image:expedition_research:textures/quests/923bbd909f80299c685d8336.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/6aaff4da25b9d76feee28c39.png width:240 height:120 align:center}"
				"按下列真实材料与个人资格准备。"
				"磁力之戒／错位之戒解决拾取，永恒智慧卷轴保存经验。佩戴到对应槽位并实际启用，观察按钮和范围。不同配装可能吸走自动化输出，应按需关闭。它们是实用分支，不要求先拿深渊之心。"
				"磁力之戒或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "3CDDD55623AE15F5"
			title: "探索术石按场景选择"
			icon: "enigmaticlegacy:ocean_stone"
			x: -4.32d
			y: 2.16d
			optional: true
			tasks: [
				{
					id: "48BC59555BBE4BFC"
					type: "item"
					item: "enigmaticlegacy:ocean_stone"
					count: 1
