	quests: [
		{
			id: "53DD3EF9A31ECA58"
			title: "了解七咒与灵魂回收"
			icon: "enigmaticlegacy:cursed_ring"
			x: -10.08d
			y: -0.72d
			optional: true
			tasks: [
				{
					id: "55506CA7D5385289"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: ["{image:expedition_research:textures/quests/e35f6403937f4ecc908e26a8.png width:32 height:32 align:center}" "检查饰品栏中佩戴的七咒之戒、生命与护甲状态，准备灵魂水晶和死亡后的回收路线。七咒之戒会自动佩戴且无法取下。仍可正常睡眠。无需主动死亡或尝试卸戒。" "查看自己的诅咒状态，并准备可靠的回收路线。" "按配装需要选择神秘遗物分支。"]
		}
		{
			id: "5FCF2E633B70D1B0"
			title: "怪奇宝典中的启示之证"
			icon: "enigmaticlegacy:the_acknowledgment"
			x: -7.2d
			y: -0.72d
			optional: true
			tasks: [
				{
					id: "2B2437DDD14BCD61"
					type: "item"
					item: "enigmaticlegacy:the_acknowledgment"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/8a0059811157fa37f13bdf28.png width:32 height:32 align:center}"
				"按下列真实材料与个人资格准备。"
				"从开局怪奇宝典切换启示之证，左键空气回到宝典。页会随知识与进度解锁，阅读所有物品描述和条件。全书合并不代表页面已全部解锁。书＋书架补领宝典已在既有教程覆盖，不再重复发书奖励。"
				"启示之证或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "292BCED589D417F7"
			title: "材料有多种探索来源"
			icon: "enigmaticlegacy:earth_heart"
			x: -1.44d
			y: -4.32d
			optional: true
			tasks: [
				{
					id: "2CC8AB53B8BC0C92"
					type: "item"
					item: "enigmaticlegacy:earth_heart"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/a9c581f4e9665f63bf803ae8.png width:32 height:32 align:center}"
				"按下列真实材料与个人资格准备。"
				"探索箱取得大地之心。邪恶精髓对应佩戒击败凋灵。星尘可在末地箱取得或满足条件的潜影贝掉落。深渊之心另有佩戒比例和末影龙条件。按各件饰品的获取条件分别探索。"
				"大地之心或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
