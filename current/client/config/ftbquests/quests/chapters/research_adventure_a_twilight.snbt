			optional: true
			tasks: [
				{
					id: "2BC0BF4602265257"
					type: "item"
					item: "twilightforest:magic_map"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/c8969d373016a2e9298adbcd.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/7966a3ebdfd823476c452644.png width:240 height:120 align:center}"
				"核心与8纸。"
				"初始化地图，识别娜迦庭院、巫妖塔和各群系。保留地面返程标记。"
				"导航工具。"
				"先挑战娜迦。地图不影响资格，直接发现也可。"
			]
		}
		{
			id: "679B86E7F9409629"
			title: "获得娜迦进度"
			icon: "twilightforest:naga_courtyard_miniature_structure"
