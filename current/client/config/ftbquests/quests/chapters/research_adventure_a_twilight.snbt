	quests: [
		{
			id: "5C63E22CDDAE44B6"
			title: "激活暮色传送门"
			icon: "minecraft:diamond"
			x: -11.88d
			y: -1.08d
			optional: false
			tasks: [
				{
					id: "73C9AB9B4A1D4FE9"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/75923cf57c58fce6d2bd94da.png width:32 height:32 align:center}"
				"按portal标签：2×2水面，周边合格植物与边缘方块。激活物默认钻石。"
				"把激活物丢到水池，确认变成传送门再入内，标记返程坐标。"
				"抵达独立维度。"
				"先读L进度与地图。夜视是建议而非入场资格。"
			]
		}
		{
			id: "7A2DA127CEE7B72A"
			title: "制作魔法地图核心"
			icon: "twilightforest:magic_map_focus"
			x: -11.88d
			y: -3.24d
			optional: true
			tasks: [
				{
					id: "6903E3783928E46A"
					type: "item"
					item: "twilightforest:magic_map_focus"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/389c23d55e1e5d98cb658446.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/ccb5b2f030f4cf13ef005072.png width:240 height:120 align:center}"
				"渡鸦羽毛＋火炬浆果＋萤石粉。死灵书模型预测还有替代来源。"
				"在工作台合核心。不要把某一来源锁成唯一。"
				"得到地图关键材料。"
				"加8纸制地图，结构探索与Boss路线共用。"
			]
		}
		{
			id: "56981958904B4D7D"
			title: "用魔法地图定位结构"
			icon: "twilightforest:magic_map"
			x: -9.72d
