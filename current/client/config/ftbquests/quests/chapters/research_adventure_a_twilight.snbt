			description: ["{image:expedition_research:textures/quests/58cf98f56768e863a5a4de9f.png width:32 height:32 align:center}" "娜迦庭院。准备基础战斗装备。" "按冲撞节奏避让/输出并确认进度，拾取鳞片或奖杯。" "巫妖资格沿此进度判断。"]
		}
		{
			id: "3A71520BD117C2B7"
			title: "取得巫妖进度后选择分支"
			icon: "twilightforest:lich_tower_miniature_structure"
			x: -5.4d
			y: -1.08d
			optional: false
			tasks: [
				{
					id: "654079E9D4483281"
					type: "advancement"
					advancement: "twilightforest:progress_lich"
					criterion: ""
				}
			]
			description: [
				"{image:expedition_research:textures/quests/496d1a03e5286f535ddf2cc6.png width:32 height:32 align:center}"
				"娜迦进度＋巫妖战斗或允许的战利品条件。"
				"处理护盾法球与仆从，完成后查进度。"
				"同时开放沼泽、雪地、黑暗森林三条分支。"
				"三支顺序任选，不用先雪怪再米诺菇。"
			]
		}
		{
			id: "7ACA6AE5DC4085DA"
			title: "探索迷宫并取得沙拉酱肉"
			icon: "twilightforest:meef_stroganoff"
			x: -3.24d
			y: -4.68d
			optional: false
			tasks: [
				{
					id: "21EF7CD83BBB2504"
