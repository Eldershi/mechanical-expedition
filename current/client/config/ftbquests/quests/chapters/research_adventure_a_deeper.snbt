					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/1ecd973d573f3d8285365639.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/8b10a4d00240c193275c13a7.png width:222 height:76 align:center}"
				"古城箱20%附加甲壳，或监守者实体表附加1–3。"
				"任选来源取甲壳。与深渊之心不是同一物。"
				"可做强化回响碎片。"
			]
		}
