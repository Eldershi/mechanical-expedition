			title: "古城搜寻与静音准备"
			icon: "minecraft:deepslate_tiles"
			x: -7.2d
			y: -1.08d
			optional: false
			tasks: [
				{
					id: "4C98E1DF0A0590B1"
					type: "advancement"
					advancement: "deeperdarker:main/find_ancient_city"
					criterion: ""
				}
			]
			description: [
				"{image:expedition_research:textures/quests/22d7df07dcc96c5b5824e476.png width:32 height:32 align:center}"
				"寻找远古城市。照明与撤退准备。"
				"小心花瓶可能生成生物。灵魂粉尘/水晶对应药水与装备。"
				"古城的实物与进度线索。"
				"甲壳可来自古城箱或监守者，升级装备不必统一锁成击杀。"
			]
		}
		{
			id: "64FCB0158E732ACC"
			title: "监守者甲壳的多种来源"
			icon: "deeperdarker:warden_carapace"
