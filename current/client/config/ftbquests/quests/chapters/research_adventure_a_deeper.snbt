					item: "deeperdarker:heart_of_the_deep"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/0a0fd7790f1cccc5f21adde0.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/7a16c811676371b01aa1d251.png width:222 height:76 align:center}"
				"监守者实体战利品附加规则，或HN监守者预测的战利品制造路线。"
				"可挑战监守者收心。若已有监守者模型预测，也能由战利品制造机产心。两来源任选一种，。"
				"心是入门消耗物，也参与法杖。"
				"先决定开门或做杖。同一颗不能被当作两次使用。"
			]
		}
		{
			id: "7C2109A64DCB4434"
			title: "在远古城框架打开幽冥入口"
			icon: "minecraft:reinforced_deepslate"
			x: -1.44d
			y: 0.09d
			optional: false
			tasks: [
				{
					id: "1349DAA9BE2F869B"
