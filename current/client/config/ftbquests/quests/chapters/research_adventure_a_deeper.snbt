			description: [
				"{image:expedition_research:textures/quests/526e8c0decf8645615107525.png width:32 height:32 align:center}"
				"在幽冥探索神庙。"
				"先处理尖啸体与潜在怪物，再逐层搜箱，找幽匿传讯器。"
				"结构进度与远程交互工具来源。"
				"传讯器用途是容器/功能方块访问，非召唤或跨维度传送。"
			]
		}
		{
			id: "3C8F937707CE590A"
			title: "在同维度已加载区块使用传讯器"
			icon: "deeperdarker:sculk_transmitter"
