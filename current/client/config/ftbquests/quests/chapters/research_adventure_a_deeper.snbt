			description: [
				"{image:expedition_research:textures/quests/854ebbf9263ca36f05258673.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/d46103f61a667197527c485f.png width:232 height:72 align:center}"
				"监守者模板＋下界合金头盔＋强化回响碎片。锻造台。"
				"执行升级。其他部件同族配方逐件查询。"
				"装备路线与维度入口材料独立。"
			]
		}
