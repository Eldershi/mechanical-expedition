		}
		{
			id: "06019AF946CC6329"
			title: "合金炉：去氧化并处理过热"
			icon: "eternal_starlight:alloy_furnace"
			x: 7.2d
			y: 3.6d
			optional: true
			tasks: [
				{
					id: "58E6BD8CC68EF15D"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/83a7080b67147cd44e85b3dd.png width:32 height:32 align:center}"
				"从Boss袋取得氧化合金炉，用斧头去氧化。可涂粗绯夜脂。"
				"按alloy类别配方生产，监视GUI温度并加入负温试管/永冻材料降温。"
				"一个独立加工能力。不能用拥有炉子代替运转。"
				"只让实际alloy配方依赖此能力。不倒锁普通钢的烧炼。"
			]
		}
		{
			id: "44EA3EBA3967039E"
			title: "纹章与战斗技能"
			icon: "eternal_starlight:lunar_crystal"
			x: -5.04d
			y: -9.36d
			optional: true
			tasks: [
				{
					id: "6A99C72D8BD51CFB"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: ["{image:expedition_research:textures/quests/28e1f3f9c6152d1c71859c1f.png width:32 height:32 align:center}" "先知球体。" "在GUI查看已拥有纹章，选一种对应元素水晶支持施法，不要求所有水晶。"]
		}
	]
