					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/f50247a64991b0f03aa17cbb.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/6d446cd342a42959f4305b99.png width:240 height:120 align:center}"
				"按工作台配方制混合物，再通过烧炼得到导管黏合剂。"
				"获得导管共同的外壳材料。"
				"按物流对象选择物品、能量、流体或红石导管。"
			]
		}
		{
			id: "6CAC077412BD216B"
			title: "烧成导管黏合剂"
