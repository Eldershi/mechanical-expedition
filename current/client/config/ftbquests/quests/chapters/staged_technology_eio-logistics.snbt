					item: "enderio:conduit_binder"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/1444a364dd9d946c79532f24.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/74df0d1053abc4601e097167.png width:240 height:120 align:center}"
				"已取得导管黏合剂混合物。"
				"用熔炉配方烧制，取出成品。不要求先造末影接口电炉。"
				"得到可消耗的导管材料。"
				"与各类合金配合制导管。"
			]
		}
