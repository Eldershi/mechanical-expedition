					item: "cmi:blaze_unit"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/d0e2f349c6678c24ed9c49ed.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/36f09d15cc7e8a9fe7f19488.png width:240 height:98 align:center}"
				"热力单元＋100mB烈焰血。流体灌装机与FE。"
				"把热力单元及烈焰血接入灌装机，收烈焰单元。"
				"目标物输出，100mB烈焰血实际消耗。"
				"用于红石炉、感应炉和流体精炼机。烈焰血取得交匠魂真实路线。"
			]
		}
		{
			id: "167A05A377677F62"
			title: "玄岩血灌装玄岩单元"
			icon: "cmi:basalz_unit"
