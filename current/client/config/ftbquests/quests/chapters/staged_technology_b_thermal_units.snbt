	quests: [
		{
			id: "6B48FAF3761FBBF2"
			title: "Thermal Construct血液与工具联动"
			icon: "thermal:basalz_rod"
			x: -1.6d
			y: 5.614d
			optional: true
			tasks: [
				{
					id: "2646EE16E503ADED"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/71db393ac07672d555edb222.png width:32 height:32 align:center}"
				"已装Thermal Construct0.0.5。"
				"用实体熔炼配方处理岩石人/烈风人/暴雪人。每次配方damage2输出对应血20mB。仅按机制准备可容纳实体的冶炼设施。"
				"血液类型可在储罐/配方查询核对。"
				"100mB血灌对应单元。工具整合强化注意Thermal Extra存在时选择兼容配方。"
			]
		}
		{
			id: "3D84E49881C50345"
			title: "热力侧面、自动IO和供电检查"
			icon: "thermal:wrench"
			x: -4.6d
			y: 0.114d
			optional: false
			tasks: [
				{
					id: "7339AAE81AF291F0"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/ca04cbe553fa5302180650c4.png width:32 height:32 align:center}"
				"有FE与所选机器。先查物料配方。"
				"GUI侧栏设置输入蓝、输出橙及需要的混合面，启用实际自动输入/输出，核红石条件。接小批已知原料。"
				"机器能取入、完成加工并排出。电池拥有量不代替加工观察。"
				"把机器扩展到多股流体和副产缓存。"
			]
		}
		{
			id: "15671F9C63EADAAD"
			title: "装配热力单元"
			icon: "cmi:thermal_unit"
			x: -1.619d
			y: 3.117d
			optional: false
			tasks: [
				{
					id: "29134EF91819CDAB"
					type: "item"
					item: "cmi:thermal_unit"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/9401fb76d8483fb90baa5d7e.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/ee9a09c2545dd0de4a41fecf.png width:240 height:95 align:center}"
				"50mB树脂、信素板与殷钢板。部件装配机和FE。"
				"配好物品槽和流体输入，按装配配方加工。"
				"取得热力单元。未知输出概率不猜。"
				"磨粉/灌装/锯木等设备的实际材料接口。"
			]
		}
		{
			id: "1FEE7574214E1100"
			title: "灌装烈焰单元"
			icon: "cmi:blaze_unit"
			x: 2.803d
			y: -5.614d
			optional: false
			tasks: [
				{
					id: "32A1B2EC28375F57"
