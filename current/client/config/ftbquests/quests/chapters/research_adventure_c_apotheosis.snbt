	quests: [
		{
			id: "282E52103FFA0294"
			title: "从词缀装备开始"
			icon: "apotheosis:salvaging_table"
			x: -2.88d
			y: -1.67d
			optional: true
			tasks: [
				{
					id: "5D788171A3BD3B31"
					type: "item"
					item: "apotheosis:salvaging_table"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/e8f5eaec618f5b36b14e9ffa.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/8f3298a1af048d8acd1e399a.png width:240 height:120 align:center}"
				"按下列真实材料与个人资格准备。"
				"从入侵者、探索宝箱或其他有效来源取得词缀装备，先阅读词缀再决定留用或回收。宝石可用落下的铁砧碾为宝石粉，随后制作回收台。回收会消耗投入的装备。先确认镶嵌宝石与重要附魔。"
				"回收台或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "1AD8CB7B991D2044"
			title: "宝石切割与镶孔"
			icon: "apotheosis:gem_cutting_table"
			x: 0.0d
			y: -4.68d
			optional: true
			tasks: [
				{
					id: "2FF4FB1685C255CC"
					type: "item"
					item: "apotheosis:gem_cutting_table"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/0d15f2906c94d7461ca59758.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/f7f852d3599665950f1b27ad.png width:240 height:120 align:center}"
				"按下列真实材料与个人资格准备。"
				"准备宝石、宝石粉和对应珍宝材料，在切割台选择配方查询给出的升级，不能假设所有纯度用同样数量。镶嵌前核对装备部位与宝石适用类型，在锻造台使用镶孔。"
				"宝石切割台或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "049E89F260D7BC11"
			title: "先用简易重铸台"
			icon: "apotheosis:simple_reforging_table"
			x: 2.88d
			y: -2.52d
			optional: true
			tasks: [
				{
					id: "445C9AC8AF450017"
					type: "item"
					item: "apotheosis:simple_reforging_table"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/30e18fbcbb020cfca0a39e12.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/53621b5fea1b2bf970509372.png width:240 height:120 align:center}"
				"按下列真实材料与个人资格准备。"
				"把适用装备、新生符石、对应稀有度珍宝材料放入，付经验选择重铸结果。简易台与完整重铸台有品质上限差异。材料稀有度、词缀和镶孔数据都应在界面确认。"
				"简易重铸台或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "66E609AF1FCA0D7D"
			title: "重铸与单词缀强化"
			icon: "apotheosis:augmenting_table"
			x: 5.76d
			y: -2.52d
			optional: true
			tasks: [
				{
					id: "6C877697F16DB611"
					type: "item"
					item: "apotheosis:augmenting_table"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/55452db9025461a719ddac94.png width:32 height:32 align:center}"
				"按下列真实材料与个人资格准备。"
				"完整重铸台支持更高稀有度。强化台使用强化符石修改单个词缀。先比较改变前后的词缀，再投入材料，避免为了追求颜色破坏配装。神话重铸的基础费用为2珍宝材料、5新生符石、50级。重铸手册说明第二、第三选项分别收取2倍、3倍基础费用。按实际选项读界面费用。它不是台子合成成本，也不保证某条词缀。"
				"强化台或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "59AAD5C2521A05E7"
			title: "建立可调附魔场地"
			icon: "apotheosis:infused_hellshelf"
			x: -5.76d
