	quests: [
		{
			id: "5B4168AD3FC17EA6"
			title: "在主世界基岩上获得无限粉末"
			icon: "enderio:grains_of_infinity"
			x: -10.5d
			y: -1.5d
			optional: false
			tasks: [
				{
					id: "2407D9348FEDCF61"
					type: "item"
					item: "enderio:grains_of_infinity"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/48aa2bec0f2c44594fd1803e.png width:32 height:32 align:center}"
				"燃烧配方限定主世界基岩，配置fireMinAge=260tick。"
				"在基岩上点火，等待超过最小火龄后自然熄灭并收集。单次不保证掉落，战利品表概率0.5。"
				"获得原始合金炉和机壳的起始材料。"
				"制作原始合金炉，或先建立可观察的安全打火收集装置。"
			]
		}
		{
			id: "182F442443FAC0F1"
			title: "建造燃料式原始合金炉"
			icon: "enderio:primitive_alloy_smelter"
