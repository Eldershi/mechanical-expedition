			optional: true
			tasks: [
				{
					id: "0E28D85C7096FD47"
					type: "item"
					item: "l2hostility:detector_glasses"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/53135f202b7a0f43ec3ca071.png width:32 height:32 align:center}"
				"按下列真实材料与个人资格准备。"
				"在库存难度面板查看玩家、区块与实体等级，用教程书／配方查询查看词条最低等级和反制。避免直接饮用大量瓶装恶意而超出应对能力。"
				"侦测眼镜或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "4151F6441AC3EB74"
			title: "两种早期宝珠并行"
			icon: "l2hostility:charm_of_looting_1"
			x: -7.2d
			y: -2.16d
			optional: true
			tasks: [
				{
					id: "0716AE9DE3589E00"
					type: "item"
					item: "l2hostility:charm_of_looting_1"
					count: 1
					consume_items: false
					only_from_crafting: false
				}
			]
			description: [
				"{image:expedition_research:textures/quests/6b9229856c9cd66292468996.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/947ec60cc03ee3b353a1ea57.png width:240 height:120 align:center}"
				"按下列真实材料与个人资格准备。"
				"粗糙抢夺宝珠用金、铜、绿宝石制作。魔能抢夺宝珠用烈焰粉、龙息、钻石单独制作，不要求先做粗糙宝珠。佩戴后击杀含相应词条的怪才会按条件掉材料。取得宝珠不等于刷到材料。"
				"粗糙抢夺宝珠或其对应工艺能力。"
				"按自己配装缺口选择分支，不要求全部收集。"
			]
		}
		{
			id: "43D05657ED25A5E4"
			title: "混沌与奇迹分开准备"
			icon: "l2hostility:charm_of_looting_3"
			x: 1.44d
			y: -0.86d
			optional: true
			tasks: [
				{
					id: "3AEDFEBDF40AC44C"
					type: "item"
					item: "l2hostility:charm_of_looting_3"
					count: 1
