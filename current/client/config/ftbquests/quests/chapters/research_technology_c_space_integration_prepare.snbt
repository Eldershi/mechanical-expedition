	quests: [
		{
			id: "6521F53C3D898739"
			title: "IE炼油厂调配火箭燃油接口"
			icon: "minecraft:book"
			x: 7.0d
			y: -5.65d
			optional: true
			tasks: [
				{
					id: "02C1BD08B4A68006"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/aa54517346f3486ebe63710a.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/5170aa013bec2458b4255f09.png width:240 height:126 align:center}"
				"25mB氧流体、250mB煤油、木炭粉催化剂及IE炼油厂FE。输入是Forge流体。"
				"按RocketFuelProcess配方双路供液并保留木炭粉催化，完成能量120的配方。"
				"合法氧气在同一输入槽任选。燃油只是一阶燃料的一个选项。"
				"50mB 燃油进入出口，催化剂保留。供液和产液量分别核对。"
				"交检查际燃料接收与航天用途。不新增T3、Boss或异界门槛。"
			]
		}
		{
			id: "5FF5B0E081F021FE"
			title: "打开银河系漫游指南"
			icon: "patchouli:guide_book"
