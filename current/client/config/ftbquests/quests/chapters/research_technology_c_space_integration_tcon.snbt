			]
			description: [
				"{image:expedition_research:textures/quests/f016aee95377ba1a91f18a21.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/0824ebe6093164492c9c9538.png width:240 height:119 align:center}"
				"有铸造盆、可接受的焦黑块与360mB熔融铜。"
				"在盆中放一个焦黑块，浇入360mB铜，得到控制器。被浇块消耗。"
				"一条恢复的蒸汽前配方成立。"
				"也可使用构件工作台路线，任选一种方式制作。"
			]
		}
		{
			id: "429A2F41DD0A74B2"
			title: "构件路线：合成冶炼炉控制器"
			icon: "tconstruct:smeltery_controller"
			x: -5.5d
			y: 2.0d
			optional: true
			tasks: [
				{
					id: "153732FB30D62F2E"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: [
				"{image:expedition_research:textures/quests/f016aee95377ba1a91f18a21.png width:32 height:32 align:center}"
				"{image:expedition_research:textures/quests/5d7953d46456d7cfe2ce666a.png width:240 height:120 align:center}"
				"已有铜构件、铁构件、硫化橡胶和焦黑材料。"
				"按工作台配方合成控制器。也可选择铜浇铸控制器的路线。"
				"与魔改控制器配方并行。"
				"只需要其中一条提供的控制器即可建炉。"
			]
		}
		{
			id: "565F6DA622BFBC30"
			title: "完成矩形冶炼炉与浇铸"
			icon: "minecraft:book"
			x: -1.5d
			y: 0.0d
			optional: false
			tasks: [
				{
					id: "224372C45233F307"
					type: "checkmark"
					title: "完成操作"
				}
			]
			description: ["任选一路取得控制器。准备焦黑合法炉体、排液口、燃料和铸造装置。" "按矩形结构建造，底部不放玻璃。控制器识别后熔化一批金属并成功浇铸。" "得到可运行的熔炼/合金/浇铸能力。" "需要副产物时再考虑熔铸炉。不要把两类炉子能力混用。"]
		}
