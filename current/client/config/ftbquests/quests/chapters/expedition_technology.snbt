		{
			id: "07572AE4030D628D"
			title: "首批精密构件"
			icon: "cmi:coil_mechanism"
			x: -2.0d
			y: 2.0d
			description: ["黄铜板经模具成形、浇入熔融黄铜，再装入电子管、齿轮半成品与机械零件，得到首批精密构件。" "接入组件装配与工程零件后，再扩展线圈和电气设备。"]
			tasks: [
				{
					id: "332EC328297C9EAE"
