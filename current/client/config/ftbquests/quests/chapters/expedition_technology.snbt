		{
			id: "49FAC7F5B7F68763"
			title: "蒸汽动力"
			icon: "cmi:bronze_mechanism"
			x: -8.0d
			y: -1.0d
			description: ["准备青铜构件，建立燃料、供水与蒸汽动力。青铜板经构件模具成形、浇入熔融青铜，再装入齿轮半成品、青铜板和机械零件。" "先让一套锅炉与引擎持续驱动加工工位，再扩展供水和燃料缓存。"]
			tasks: [
				{
					id: "2079063D8FF2FDFC"
					type: "item"
					item: "cmi:bronze_mechanism"
					consume_items: false
				}
