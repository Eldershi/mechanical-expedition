		}
		{
			id: "4CD9E4503188C96B"
			title: "铁路与远方矿点"
			icon: "cmi:railway_mechanism"
			x: -2.0d
			y: -4.0d
			description: ["用致密坚固板、熔融工业铁、齿轮、黄铜板与机械零件制造铁路构件。" "连接车站、轨道和装卸点，设置时刻表，把远方矿点的产物送回基地。铁路运输与精密制造可以并行准备。"]
			tasks: [
				{
					id: "3DFB21B9F171873E"
